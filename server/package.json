{
  "name": "@comb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "allowlist:clear": "tsx --env-file-if-exists=../.env src/tools/allowlist-clear.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@comb/shared": "^0.1.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/argon2": "^2.2.2",
    "@node-saml/node-saml": "^5.1.0",
    "fastify": "^5.12.7",
    "libpg-query": "^18.2.1",
    "openid-client": "^6.8.8",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pg-cursor": "^2.22.1",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
